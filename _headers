# Headers for static files served by Cloudflare's assets layer (the Worker's hook never sees
# these requests). Keep in step with SECURITY_HEADERS in src/hooks.server.ts.
/*
  Strict-Transport-Security: max-age=15552000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# The unhashed files: revalidated on every visit, like the pages, so a deploy is picked up at once
# (the ETag makes it a 304). theme.js blocks the first paint, so a stale copy would dress the page in
# a theme the app no longer has.
/manifest.webmanifest
  Cache-Control: no-cache
/service-worker.js
  Cache-Control: no-cache
/theme.js
  Cache-Control: no-cache
