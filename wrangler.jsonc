{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "lethal-chess",
	// Written by @sveltejs/adapter-cloudflare on `pnpm build`.
	"main": ".svelte-kit/cloudflare/_worker.js",
	// Newest date the pinned workerd runtime supports; bump together with wrangler.
	"compatibility_date": "2026-09-11",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// A per-user cap on how often the write API may be called. Keyed by user id inside `authed()`, so
	// one account cannot spend everyone else's budget, and a shared address is not punished for it.
	"ratelimits": [
		{
			"name": "API_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 60, "period": 60 }
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lethal-chess",
			// Created with `wrangler d1 create lethal-chess --jurisdiction eu`: data is stored and
			// processed only within the EU. Local dev uses a local copy and ignores this id.
			"database_id": "54d665c7-6bd5-4009-a784-db8086d56277",
			"migrations_dir": "migrations"
		}
	],
	// The Worker serves the real domain; `www` only redirects to it (see src/hooks.server.ts).
	// Only the custom domains serve the app: no second origin on workers.dev or preview URLs.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{ "pattern": "lethalchess.com", "custom_domain": true },
		{ "pattern": "www.lethalchess.com", "custom_domain": true }
	],
	// Errors and console output are kept for debugging; per-request invocation logs are off,
	// so visitors' IP addresses and full URLs (including OAuth callback codes) are not logged.
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": false
		}
	}
}
